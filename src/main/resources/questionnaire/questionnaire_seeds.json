            {
              "field_key": "cobra_open_enrollment_allowed",
              "label": "Are employees allowed to add / change coverage for your upcoming benefit renewal?",
              "field_type": "RADIO",
              "select_options": "YES|NO",
              "is_required": true
            },
            {
              "field_key": "cobra_benefits_changing",
