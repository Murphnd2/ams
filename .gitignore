# Build output
/target/
/out/

# Claude Code — selectively track shared assets, ignore local/runtime state
.claude/*
!.claude/skills/
!.claude/prompts/
!.claude/agents/
!.claude/hooks/
!.claude/commands/
!.claude/launch.json
!.claude/CLAUDE.md
!.claude/toolkit
.claude/settings.local.json
.claude/worktrees/
.claude/inventory/
# .claude/memory/ intentionally NOT un-ignored (2026-07-30): docs/claude_memory.md is now the
# single authoritative current-state doc; .claude/memory/MEMORY.md is a stale, duplicate,
# git-tracked file kept only so Claude Code can still write to it locally. Adding this rule does
# NOT untrack the already-tracked .claude/memory/MEMORY.md — run `git rm --cached .claude/memory/MEMORY.md` to finish untracking it.

# IntelliJ (ignore everything)
.idea/*
!.idea/codeStyles/
!.idea/runConfigurations/
!.idea/inspectionProfiles/
!.idea/vcs.xml


# JetBrains project files (legacy)
/*.iws
*.iml
*.ipr

# Other IDEs
.vscode/
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
/build/

# OS & logs
.DS_Store
*.log
*.local.properties

# Tomcat artifacts
**/webapps/
**/*.war

# Never commit local jars
src/main/webapp/WEB-INF/lib/

# Maven wrapper
!.mvn/wrapper/maven-wrapper.jar

# Local release-staging folder (WAR + migration SQL staged for GitHub Releases; never committed)
release/