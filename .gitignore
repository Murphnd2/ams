# Build output
/target/
/out/

# Claude Code — selectively track shared assets, ignore local/runtime state
.claude/*
!.claude/skills/
!.claude/prompts/
!.claude/agents/
!.claude/hooks/
!.claude/commands/
!.claude/launch.json
!.claude/CLAUDE.md
!.claude/memory/
.claude/settings.local.json
.claude/worktrees/
.claude/inventory/

# IntelliJ (ignore everything)
.idea/*
!.idea/codeStyles/
!.idea/runConfigurations/
!.idea/inspectionProfiles/
!.idea/vcs.xml


# JetBrains project files (legacy)
/*.iws
*.iml
*.ipr

# Other IDEs
.vscode/
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
/build/

# OS & logs
.DS_Store
*.log
*.local.properties

# Tomcat artifacts
**/webapps/
**/*.war

# Never commit local jars
src/main/webapp/WEB-INF/lib/

# Maven wrapper
!.mvn/wrapper/maven-wrapper.jar